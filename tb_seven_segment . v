module tb_seven_segment;

reg [3:0] binary;
wire [6:0] seg;

seven_segment uut(
    .binary(binary),
    .seg(seg)
);

initial begin
    binary = 4'b0000; #10;
    binary = 4'b0001; #10;
    binary = 4'b0010; #10;
    binary = 4'b0011; #10;
    binary = 4'b0100; #10;
    binary = 4'b0101; #10;
    binary = 4'b0110; #10;
    binary = 4'b0111; #10;
    binary = 4'b1000; #10;
    binary = 4'b1001; #10;
    $finish;
end

endmodule
